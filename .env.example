# Copy this file to ".env" (same folder) and fill in what you use. ".env" stays on your computer: never share it.

# Which voice engine to use when you do not say otherwise:
#   free        = computer voice (instant, no account, sounds robotic)  <- default
#   elevenlabs  = best quality, needs ELEVENLABS_API_KEY
#   gemini      = Google Gemini TTS, needs GEMINI_API_KEY (free tier has a daily limit)
VOICE_PROVIDER=free

# ElevenLabs: https://elevenlabs.io -> profile (bottom left) -> API Keys -> Create
ELEVENLABS_API_KEY=

# Google Gemini: https://aistudio.google.com/apikey -> Create API key
GEMINI_API_KEY=
