  "lines": [
    {
      "who": "sejarah_asst",
      "text": "Profesor! Saya nak tanya. Zaman dulu, kereta tak ada butang Start ke?",
      "delivery": "curious, puzzled",
      "face": "shocked",
      "listener": "neutral",
      "shot": "wide",
      "screen": "dashboard",
      "camera": "push_in",
      "pause": 0.2
    },
    {
      "who": "sejarah_prof",
      "text": "Ha ha ha! Butang Start? Zaman dulu, nak hidupkan enjin pun bukan semudah itu!",
      "delivery": "hearty laugh, amused",
      "face": "happy",
      "listener": "shocked",
      "shot": "prof",
      "screen": "dashboard",
      "pause": 0.2
    },
    {
      "who": "sejarah_asst",
      "text": "Jadi... kena tolak kereta sampai hidup?",
      "delivery": "unsure, half joking",
      "face": "neutral",
      "listener": "happy",
      "shot": "asst",
      "screen": "tajuk",
      "action": "type",
      "pause": 0.4
    },
    {
      "who": "sejarah_prof",
      "text": "Mari kita kembali ke tahun lapan belas lapan puluh enam. Ketika itu, seorang jurutera Jerman memperkenalkan sebuah kereta bermotor, antara kereta petrol terawal dalam sejarah.",
      "delivery": "storytelling, grand",
      "face": "happy",
      "listener": "neutral",
      "shot": "full",
      "screen": "y1886",
      "pause": 0.3,
      "camera": "none"
    },
    {
      "who": "sejarah_asst",
      "text": "Wah! Kereta zaman purba! Tapi macam mana enjinnya dihidupkan?",
      "delivery": "amazed, eager",
      "face": "happy",
      "listener": "happy",
      "shot": "asst",
      "screen": "y1886",
      "pause": 0.4
    },
    {
      "who": "sejarah_prof",
      "text": "Kereta ini belum menggunakan starter motor elektrik. Enjinnya dihidupkan dengan memutarkan flai wil secara manual!",
      "delivery": "explaining, clear",
      "face": "neutral",
      "listener": "neutral",
      "shot": "full",
      "screen": "flywheel",
      "pause": 0.2,
      "camera": "none"
    },
    {
      "who": "sejarah_asst",
      "text": "Eh! Pusing roda itu dengan tangan? Bukan main kuat lagi nampaknya!",
      "delivery": "surprised, impressed",
      "face": "shocked",
      "listener": "happy",
      "shot": "asst",
      "screen": "flywheel",
      "pause": 0.2
    },
    {
      "who": "sejarah_prof",
      "text": "Betul! Apabila enjin mula beroperasi, barulah kereta boleh bergerak.",
      "delivery": "warm, nodding",
      "face": "happy",
      "listener": "neutral",
      "shot": "full",
      "screen": "flywheel",
      "pause": 0.4,
      "camera": "none"
    },
    {
      "who": "sejarah_prof",
      "text": "Apabila kereta semakin berkembang, banyak model awal menggunakan kaedah lain pula. Antaranya ialah krenk hendel yang dipasang pada bahagian hadapan enjin.",
      "delivery": "storytelling",
      "face": "neutral",
      "listener": "neutral",
      "shot": "full",
      "screen": "garismasa",
      "pause": 0.2,
      "camera": "none"
    },
    {
      "who": "sejarah_asst",
      "text": "Oh! Jadi macam engkol manual?",
      "delivery": "realising",
      "face": "happy",
      "listener": "happy",
      "shot": "asst",
      "screen": "crank",
      "pause": 0.1
    },
    {
      "who": "sejarah_prof",
      "text": "Tepat sekali!",
      "delivery": "proud, crisp",
      "face": "happy",
      "listener": "happy",
      "shot": "two",
      "screen": "crank",
      "pause": 0.4
    },
    {
      "who": "sejarah_asst",
      "text": "Profesor! Saya baru cuba bayangkan. Kalau enjin tak hidup, kena pusing lagi?",
      "delivery": "tired, worried",
      "face": "annoyed",
      "listener": "happy",
      "shot": "asst",
      "screen": "crank",
      "pause": 0.2
    },
    {
      "who": "sejarah_prof",
      "text": "Ya! Ia memerlukan tenaga, teknik dan kesabaran. Malah, krenk hendel boleh tersentak dengan kuat jika enjin mengalami kik bek!",
      "delivery": "serious, warning",
      "face": "annoyed",
      "listener": "shocked",
      "shot": "full",
      "screen": "bahaya",
      "pause": 0.2,
      "camera": "none"
    },
    {
      "who": "sejarah_asst",
      "text": "Aduh! Bahaya juga!",
      "delivery": "wincing",
      "face": "shocked",
      "listener": "neutral",
      "shot": "asst",
      "screen": "bahaya",
      "pause": 0.4
    },
    {
      "who": "sejarah_prof",
      "text": "Itulah sebabnya manusia mula mencari cara yang lebih mudah dan selamat untuk menghidupkan enjin.",
      "delivery": "thoughtful",
      "face": "neutral",
      "listener": "neutral",
      "shot": "full",
      "screen": "soalan",
      "pause": 0.2,
      "camera": "none"
    },
    {
      "who": "sejarah_asst",
      "text": "Maksud Profesor, satu hari nanti kita boleh hidupkan kereta hanya dengan menekan butang?",
      "delivery": "hopeful, excited",
      "face": "happy",
      "listener": "happy",
      "shot": "asst",
      "screen": "soalan",
      "pause": 0.2
    },
    {
      "who": "sejarah_prof",
      "text": "Betul! Tetapi perjalanan untuk sampai ke situ bukan mudah.",
      "delivery": "mysterious, slow",
      "face": "neutral",
      "listener": "neutral",
      "shot": "prof",
      "screen": "soalan",
      "pause": 0.3
    },
    {
